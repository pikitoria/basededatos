-- =====================================================
-- PROCEDIMIENTO PRINCIPAL
-- Registra una acción realizada por la mascota
-- =====================================================

CREATE PROCEDURE sp_realizaraccion(
    -- Sesión donde se realiza la acción
    IN p_idsession INT,

    -- Acción realizada
    IN p_idaction INT,

    -- Mensaje de salida
    OUT p_mensaje VARCHAR(100)
)
BEGIN

    -- Guarda la acción en el historial
    INSERT INTO actionlogs(
        IDsession,
        IDaction,
        timestamp
    )
    VALUES(
        p_idsession,
        p_idaction,
        NOW()
    );

    -- Mensaje de confirmación
    SET p_mensaje = 'accion registrada';

END //

-- =====================================================
-- PROCEDIMIENTO ALIMENTAR
-- Ejecuta la acción alimentar
-- =====================================================

CREATE PROCEDURE sp_alimentar(
    IN p_idsession INT,
    OUT p_mensaje VARCHAR(100)
)
BEGIN

    -- Acción número 1
