-- =====================================================
-- CREACIÓN DE LA BASE DE DATOS
-- =====================================================

-- Crea la base de datos principal del proyecto
CREATE DATABASE mascotavirtual;

-- Selecciona la base de datos para trabajar en ella
USE mascotavirtual;

-- =====================================================
-- TABLA PLAYERS
-- Guarda la información de los jugadores
-- =====================================================

CREATE TABLE players(

    -- Identificador único del jugador
    IDplayer INT AUTO_INCREMENT PRIMARY KEY,

    -- Nombre del jugador
    nombre VARCHAR(50) NOT NULL,

    -- Correo electrónico único
    email VARCHAR(100) UNIQUE NOT NULL

);

-- =====================================================
-- TABLA PETS
-- Guarda las mascotas de cada jugador
-- =====================================================

CREATE TABLE pets(

    -- Identificador único de la mascota
    IDpet INT AUTO_INCREMENT PRIMARY KEY,

    -- Jugador dueño de la mascota
    IDplayer INT NOT NULL,

    -- Nombre de la mascota
    nombre VARCHAR(50) NOT NULL,

    -- Tipo de mascota (perro, gato, etc.)
    tipo VARCHAR(30) NOT NULL,

    -- Fecha de creación de la mascota
    fecha_creacion DATE NOT NULL,

    -- Relación con la tabla players
    FOREIGN KEY(IDplayer)
    REFERENCES players(IDplayer)

);

-- Un jugador puede tener varias mascotas
-- PLAYER 1 ---- N PETS

-- =====================================================
-- TABLA SESSIONS
-- Guarda las partidas realizadas
-- =====================================================

CREATE TABLE sessions(

    -- Identificador de la sesión
    IDsession INT AUTO_INCREMENT PRIMARY KEY,

    -- Mascota asociada a la sesión
    IDpet INT NOT NULL,

    -- Fecha y hora de inicio
    inicio DATETIME NOT NULL,

    -- Fecha y hora de finalización
    fin DATETIME,

    -- Duración total en minutos
    duracion INT,

    -- Relación con la mascota
    FOREIGN KEY(IDpet)
    REFERENCES pets(IDpet)

);

-- Una mascota puede tener muchas sesiones
-- PET 1 ---- N SESSIONS

-- =====================================================
-- TABLA PETSTATELOGS
-- Guarda el estado histórico de la mascota
-- =====================================================

CREATE TABLE petstatelogs(

    -- Identificador del registro
    IDlog INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión relacionada
    IDsession INT NOT NULL,

    -- Momento en que se registró el estado
    timestamp DATETIME NOT NULL,

    -- Nivel de hambre (0 a 100)
    hambre INT CHECK(hambre BETWEEN 0 AND 100),

    -- Nivel de diversión (0 a 100)
    diversion INT CHECK(diversion BETWEEN 0 AND 100),

    -- Nivel de higiene (0 a 100)
    higiene INT CHECK(higiene BETWEEN 0 AND 100),

    -- Nivel de energía (0 a 100)
    energia INT CHECK(energia BETWEEN 0 AND 100),

    -- Nivel de salud (0 a 100)
    salud INT CHECK(salud BETWEEN 0 AND 100),

    -- Relación con la sesión
    FOREIGN KEY(IDsession)
    REFERENCES sessions(IDsession)

);

-- Permite registrar la evolución de la mascota
-- durante toda la partida.

-- =====================================================
-- TABLA ACTIONTYPES
-- Define las acciones disponibles en el juego
-- =====================================================

CREATE TABLE actiontypes(

    -- Identificador de la acción
    IDaction INT AUTO_INCREMENT PRIMARY KEY,

    -- Nombre de la acción
    nombre VARCHAR(50) NOT NULL,

    -- Efectos que provoca sobre la mascota
    efecto_hambre INT,
    efecto_diversion INT,
    efecto_higiene INT,
    efecto_energia INT,
    efecto_salud INT

);

-- Ejemplos:
-- Alimentar
-- Jugar
-- Dormir
-- Asear

-- =====================================================
-- TABLA ACTIONLOGS
-- Historial de acciones realizadas
-- =====================================================

CREATE TABLE actionlogs(

    -- Identificador del registro
    IDlog INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión donde ocurrió la acción
    IDsession INT NOT NULL,

    -- Acción realizada
    IDaction INT NOT NULL,

    -- Fecha y hora de ejecución
    timestamp DATETIME NOT NULL,

    FOREIGN KEY(IDsession)
    REFERENCES sessions(IDsession),

    FOREIGN KEY(IDaction)
    REFERENCES actiontypes(IDaction)

);

-- Permite saber qué hizo el jugador
-- durante cada partida.

-- =====================================================
-- TABLA EVENTS
-- Eventos aleatorios del juego
-- =====================================================

CREATE TABLE events(

    -- Identificador del evento
    IDevent INT AUTO_INCREMENT PRIMARY KEY,

    -- Nombre del evento
    nombre VARCHAR(50) NOT NULL,

    -- Descripción del efecto
    efecto VARCHAR(100)

);

-- Ejemplos:
-- Se enferma
-- Encuentra juguete

-- =====================================================
-- TABLA EVENTLOGS
-- Historial de eventos ocurridos
-- =====================================================

CREATE TABLE eventlogs(

    -- Identificador del registro
    IDlog INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión en que ocurrió
    IDsession INT NOT NULL,

    -- Evento ocurrido
    IDevent INT NOT NULL,

    -- Fecha y hora del evento
    timestamp DATETIME NOT NULL,

    FOREIGN KEY(IDsession)
    REFERENCES sessions(IDsession),

    FOREIGN KEY(IDevent)
    REFERENCES events(IDevent)

);

-- Guarda todos los eventos aleatorios
-- producidos durante una sesión.

-- =====================================================
-- TABLA SESSIONRESULTS
-- Resultado final de cada partida
-- =====================================================

CREATE TABLE sessionresults(

    -- Identificador del resultado
    IDresult INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión evaluada
    IDsession INT NOT NULL,

    -- Promedio de felicidad de la mascota
    felicidad_promedio INT,

    -- Duración total de la partida
    duracion_total INT,

    -- Estado final de la mascota
    estado_final VARCHAR(30),

    FOREIGN KEY(IDsession)
    REFERENCES sessions(IDsession)

);

-- Resume cómo terminó la mascota
-- al finalizar la partida.

