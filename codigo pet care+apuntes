SET v_num =
FLOOR(1 + RAND()*3);

IF v_num = 1 THEN

SET p_evento =
'encontro comida';

ELSEIF v_num = 2 THEN

SET p_evento =
'encontro juguete';

ELSE

SET p_evento =
'se ensucio jugando';

END IF;

END//

