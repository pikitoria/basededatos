DELIMITER //

CREATE PROCEDURE sp_iniciarsesion(
    IN p_idplayer INT,
    IN p_idpet INT
)
BEGIN

    -- Crea una nueva sesion para el jugador y la mascota

    INSERT INTO Sessions(
        IDplayer,
        IDpet,
        inicio,
        fin,
        duracion
    )
    VALUES(
        p_idplayer,
        p_idpet,
        NOW(),
        NULL,
        0
    );

    -- Se crea el estado inicial de la mascota
    -- Hambre = 50
    -- Diversion = 50
    -- Higiene = 50
    -- Energia = 50
    -- Salud = 80

    INSERT INTO PetStateLogs(
        IDsession,
        timestamp,
        hambre,
        diversion,
        higiene,
        energia,
        salud
    )
    VALUES(
        LAST_INSERT_ID(),
        NOW(),
        50,
        50,
        50,
        50,
        80
    );

    -- Muestra la sesion creada

    SELECT
        LAST_INSERT_ID() AS NuevaSesion,
        p_idplayer AS Jugador,
        p_idpet AS Mascota;

END //

CREATE PROCEDURE sp_alimentar(
    IN p_idsession INT,
    IN p_porciones INT
)
BEGIN

    -- Registra la accion alimentar

    INSERT INTO ActionLogs(
        IDsession,
        IDaction,
        timestamp
    )
    VALUES(
        p_idsession,
        1,
        NOW()
    );

    -- Toma el ultimo estado de la mascota y aplica:
    -- Hambre -30 por porcion
    -- Energia +5 por porcion
    -- Salud +10 por porcion

    INSERT INTO PetStateLogs(
        IDsession,
        timestamp,
        hambre,
        diversion,
        higiene,
        energia,
        salud
    )
    SELECT
        p_idsession,
        NOW(),
        hambre - (30 * p_porciones),
        diversion,
        higiene,
        energia + (5 * p_porciones),
        salud + (10 * p_porciones)
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

    -- Muestra el nuevo estado

    SELECT *
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

END //

CREATE PROCEDURE sp_jugar(
    IN p_idsession INT,
    IN p_minutos INT
)
BEGIN

    -- Registra la accion jugar

    INSERT INTO ActionLogs(
        IDsession,
        IDaction,
        timestamp
    )
    VALUES(
        p_idsession,
        2,
        NOW()
    );

    -- Efectos:
    -- Hambre aumenta
    -- Diversion aumenta
    -- Higiene disminuye
    -- Energia disminuye
    -- Salud aumenta ligeramente

    INSERT INTO PetStateLogs(
        IDsession,
        timestamp,
        hambre,
        diversion,
        higiene,
        energia,
        salud
    )
    SELECT
        p_idsession,
        NOW(),
        hambre + (p_minutos / 3),
        diversion + p_minutos,
        higiene - (p_minutos / 4),
        energia - (p_minutos / 2),
        salud + 5
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

    -- Muestra el nuevo estado

    SELECT *
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

END //

CREATE PROCEDURE sp_asear(
    IN p_idsession INT,
    IN p_intensidad INT
)
BEGIN

    -- Registra la accion asear

    INSERT INTO ActionLogs(
        IDsession,
        IDaction,
        timestamp
    )
    VALUES(
        p_idsession,
        3,
        NOW()
    );

    -- Efectos:
    -- Higiene aumenta
    -- Energia disminuye
    -- Salud aumenta

    INSERT INTO PetStateLogs(
        IDsession,
        timestamp,
        hambre,
        diversion,
        higiene,
        energia,
        salud
    )
    SELECT
        p_idsession,
        NOW(),
        hambre,
        diversion,
        higiene + (50 * p_intensidad),
        energia - (10 * p_intensidad),
        salud + (5 * p_intensidad)
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

    -- Muestra el nuevo estado

    SELECT *
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

END //

CREATE PROCEDURE sp_dormir(
    IN p_idsession INT,
    IN p_horas INT
)
BEGIN

    -- Registra la accion dormir

    INSERT INTO ActionLogs(
        IDsession,
        IDaction,
        timestamp
    )
    VALUES(
        p_idsession,
        4,
        NOW()
    );

    -- Efectos:
    -- Hambre disminuye
    -- Energia aumenta
    -- Salud aumenta

    INSERT INTO PetStateLogs(
        IDsession,
        timestamp,
        hambre,
        diversion,
        higiene,
        energia,
        salud
    )
    SELECT
        p_idsession,
        NOW(),
        hambre - (10 * p_horas),
        diversion,
        higiene,
        energia + (50 * p_horas),
        salud + (10 * p_horas)
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

    -- Muestra el nuevo estado

    SELECT *
    FROM PetStateLogs
    WHERE IDsession = p_idsession
    ORDER BY IDlog DESC
    LIMIT 1;

END //

CREATE PROCEDURE sp_buscarjugador(
    IN p_nombre VARCHAR(50),
    IN p_email VARCHAR(100)
)
BEGIN

    -- Busca un jugador por nombre o email

    SELECT *
    FROM Players
    WHERE nombre = p_nombre
       OR email = p_email;

END //

CREATE PROCEDURE sp_buscarmascota(
    IN p_tipo VARCHAR(30),
    IN p_fecha DATE
)
BEGIN

    -- Busca mascotas por tipo y fecha

    SELECT *
    FROM Pets
    WHERE tipo = p_tipo
    AND fecha_creacion >= p_fecha;

END //

CREATE PROCEDURE sp_buscarevento(
    IN p_nombre VARCHAR(50),
    IN p_descripcion VARCHAR(100)
)
BEGIN

    -- Busca eventos por nombre o descripcion

    SELECT *
    FROM Events
    WHERE nombre = p_nombre
       OR descripcion = p_descripcion;

END //

CREATE PROCEDURE sp_sesionesmascota(
    IN p_idpet INT,
    IN p_duracion INT
)
BEGIN

    -- Devuelve sesiones de una mascota
    -- que superen cierta duracion

    SELECT *
    FROM Sessions
    WHERE IDpet = p_idpet
    AND duracion >= p_duracion;

END //

CREATE PROCEDURE sp_veracciones(
    IN p_idsession INT,
    IN p_idaction INT
)
BEGIN

    -- Muestra las acciones realizadas
    -- en una sesion determinada

    SELECT
        al.IDlog,
        a.nombre,
        al.timestamp
    FROM ActionLogs al
    INNER JOIN ActionTypes a
        ON al.IDaction = a.IDaction
    WHERE al.IDsession = p_idsession
    AND al.IDaction = p_idaction;

END //

CREATE PROCEDURE sp_estadisticas(
    IN p_estado VARCHAR(30),
    IN p_felicidad INT,
    IN p_duracion INT
)
BEGIN

    -- Filtra resultados finales segun:
    -- Estado final
    -- Felicidad minima
    -- Duracion minima

    SELECT *
    FROM SessionResults
    WHERE estado_final = p_estado
    AND felicidad_promedio >= p_felicidad
    AND duracion_total >= p_duracion;

END //

DELIMITER ;
