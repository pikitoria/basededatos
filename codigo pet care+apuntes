-- ============================================================
-- procedimientos almacenados (stored procedures)
-- ============================================================

-- sp = stored procedure, o sea procedimiento almacenado: un codigo guardado
--      en la base de datos que se ejecuta con call
-- p_ = parametro, es un dato que le paso al procedimiento
-- in = el dato entra al procedimiento
-- delimiter // = cambio el ; por // para que mysql no corte el procedimiento
--      en el primer ; que encuentra. al final lo vuelvo a poner con delimiter ;
-- begin ... end = adentro va todo lo que hace el procedimiento
--
-- idea general: la mascota no guarda su estado en una sola fila que se pisa.
-- cada cambio agrega una fila nueva en petstatelogs y el estado actual es
-- la ultima fila de esa sesion.
-- order by idlog desc limit 1 = ordena de la fila mas nueva a la mas vieja
--      y se queda solo con la primera, o sea el estado actual
-- ningun procedimiento llama a otro, cada uno hace todo solo

-- ------------------------------------------------------------
-- sp_iniciarsesion
-- empieza una partida nueva para una mascota
-- se usa asi: call sp_iniciarsesion(1);   (1 = id de la mascota)
-- ------------------------------------------------------------
delimiter //
create procedure sp_iniciarsesion(in p_idpet int)
begin
    -- crea la sesion: inicio es ahora (now), fin queda vacio (null)
    -- porque todavia no termino y la duracion arranca en 0
    insert into sessions (idpet, inicio, fin, duracion)
    values (p_idpet, now(), null, 0);

    -- crea el estado inicial de la mascota: 50 en hambre, diversion,
    -- higiene y energia, y salud en 80
    -- max(idsession) = el id mas grande, o sea el de la sesion que recien se creo
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    values ((select max(idsession) from sessions), now(), 50, 50, 50, 50, 80);

    -- crea el resultado de la sesion con todo en 0 y el estado 'jugando'
    -- (despues se va a ir completando cuando termine la partida)
    insert into sessionresults (idsession, felicidad_promedio, duracion_total, estado_final)
    values ((select max(idsession) from sessions), 0, 0, 'jugando');

    -- devuelve el id de la sesion nueva, el juego lo necesita para llamar
    -- a los demas procedimientos
    select max(idsession) as idsession from sessions;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_alimentar
-- le da de comer a la mascota: baja el hambre 30 y sube la salud 10
-- se usa asi: call sp_alimentar(3);   (3 = id de la sesion)
-- ------------------------------------------------------------
delimiter //
create procedure sp_alimentar(in p_idsession int)
begin
    -- guarda en el historial de acciones que se hizo la accion 1 (alimentar)
    -- y a que hora
    insert into actionlogs (idsession, idaction, timestamp)
    values (p_idsession, 1, now());

    -- copia el ultimo estado de la mascota y guarda una fila nueva con los cambios:
    -- hambre - 30 y salud + 10, el resto queda igual
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    select p_idsession, now(), hambre - 30, diversion, higiene, energia, salud + 10
    from petstatelogs
    where idsession = p_idsession
    order by idlog desc limit 1;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_jugar
-- juega con la mascota: sube la diversion pero se cansa y se ensucia
-- cambios: hambre +10, diversion +40, higiene -10, energia -20, salud +5
-- se usa asi: call sp_jugar(3);
-- ------------------------------------------------------------
delimiter //
create procedure sp_jugar(in p_idsession int)
begin
    -- registra la accion 2 (jugar) en el historial
    insert into actionlogs (idsession, idaction, timestamp)
    values (p_idsession, 2, now());

    -- copia el ultimo estado y guarda uno nuevo con los cambios de jugar
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    select p_idsession, now(), hambre + 10, diversion + 40, higiene - 10, energia - 20, salud + 5
    from petstatelogs
    where idsession = p_idsession
    order by idlog desc limit 1;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_asear
-- baña a la mascota: sube mucho la higiene pero la cansa un poco
-- cambios: higiene +50, energia -10, salud +5
-- se usa asi: call sp_asear(3);
-- ------------------------------------------------------------
delimiter //
create procedure sp_asear(in p_idsession int)
begin
    -- registra la accion 3 (asear) en el historial
    insert into actionlogs (idsession, idaction, timestamp)
    values (p_idsession, 3, now());

    -- copia el ultimo estado y guarda uno nuevo con los cambios de asear
    -- el hambre y la diversion se copian igual
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    select p_idsession, now(), hambre, diversion, higiene + 50, energia - 10, salud + 5
    from petstatelogs
    where idsession = p_idsession
    order by idlog desc limit 1;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_dormir
-- hace dormir a la mascota: recupera mucha energia
-- cambios: hambre -10, energia +50, salud +10
-- se usa asi: call sp_dormir(3);
-- ------------------------------------------------------------
delimiter //
create procedure sp_dormir(in p_idsession int)
begin
    -- registra la accion 4 (dormir) en el historial
    insert into actionlogs (idsession, idaction, timestamp)
    values (p_idsession, 4, now());

    -- copia el ultimo estado y guarda uno nuevo con los cambios de dormir
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    select p_idsession, now(), hambre - 10, diversion, higiene, energia + 50, salud + 10
    from petstatelogs
    where idsession = p_idsession
    order by idlog desc limit 1;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_pasartiempo
-- hace que pase el tiempo solo, sin que el jugador toque nada
-- cambios: hambre +5, diversion -5, higiene -3, energia -4, salud igual
-- se usa asi: call sp_pasartiempo(3);
-- ------------------------------------------------------------
delimiter //
create procedure sp_pasartiempo(in p_idsession int)
begin
    -- no guarda nada en actionlogs porque no es una accion del jugador
    -- copia el ultimo estado y guarda uno nuevo: el hambre sube y
    -- la diversion, la higiene y la energia bajan
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    select p_idsession, now(), hambre + 5, diversion - 5, higiene - 3, energia - 4, salud
    from petstatelogs
    where idsession = p_idsession
    order by idlog desc limit 1;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_enfermar
-- evento 1: la mascota se enferma y pierde 30 de salud
-- se usa asi: call sp_enfermar(3);
-- ------------------------------------------------------------
delimiter //
create procedure sp_enfermar(in p_idsession int)
begin
    -- guarda en eventlogs que paso el evento 1 (se enferma) en esa sesion
    insert into eventlogs (idsession, idevent, timestamp)
    values (p_idsession, 1, now());

    -- copia el ultimo estado y guarda uno nuevo donde solo cambia la salud (- 30)
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    select p_idsession, now(), hambre, diversion, higiene, energia, salud - 30
    from petstatelogs
    where idsession = p_idsession
    order by idlog desc limit 1;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_encontrarjuguete
-- evento 2: la mascota encuentra un juguete y sube 20 de diversion
-- se usa asi: call sp_encontrarjuguete(3);
-- ------------------------------------------------------------
delimiter //
create procedure sp_encontrarjuguete(in p_idsession int)
begin
    -- guarda en eventlogs que paso el evento 2 (encuentra juguete)
    insert into eventlogs (idsession, idevent, timestamp)
    values (p_idsession, 2, now());

    -- copia el ultimo estado y guarda uno nuevo donde solo cambia la diversion (+ 20)
    insert into petstatelogs (idsession, timestamp, hambre, diversion, higiene, energia, salud)
    select p_idsession, now(), hambre, diversion + 20, higiene, energia, salud
    from petstatelogs
    where idsession = p_idsession
    order by idlog desc limit 1;
end //
delimiter ;

-- ------------------------------------------------------------
-- sp_estadisticas
-- muestra cuantas sesiones se jugaron y el promedio de felicidad
-- no recibe nada, se usa asi: call sp_estadisticas();
-- ------------------------------------------------------------
delimiter //
create procedure sp_estadisticas()
begin
    -- count(*) = cuenta las filas, o sea las sesiones
    -- avg(...) = saca el promedio de la columna felicidad_promedio
    -- as = le pone un nombre a la columna del resultado
    select count(*) as total_sesiones, avg(felicidad_promedio) as promedio_felicidad
    from sessionresults;
end //
delimiter ;
