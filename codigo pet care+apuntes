-- =====================================================
-- CREACIÓN DE LA BASE DE DATOS
-- =====================================================

-- Crea la base de datos
CREATE DATABASE mascotavirtual;

-- Selecciona la base de datos para trabajar
USE mascotavirtual;


-- =====================================================
-- TABLA PLAYERS
-- =====================================================

CREATE TABLE players (

    -- ID único del jugador
    IDplayer INT AUTO_INCREMENT PRIMARY KEY,

    -- Nombre del jugador
    nombre VARCHAR(50) NOT NULL,

    -- Email único
    email VARCHAR(100) UNIQUE NOT NULL

);


-- =====================================================
-- TABLA PETS
-- =====================================================

CREATE TABLE pets (

    -- ID único de la mascota
    IDpet INT AUTO_INCREMENT PRIMARY KEY,

    -- Dueño de la mascota
    IDplayer INT NOT NULL,

    -- Nombre de la mascota
    nombre VARCHAR(50) NOT NULL,

    -- Tipo de mascota
    tipo VARCHAR(30) NOT NULL,

    -- Fecha de creación
    fecha_creacion DATE NOT NULL,

    -- Clave foránea que relaciona mascota y jugador
    FOREIGN KEY (IDplayer)
    REFERENCES players(IDplayer)

);


-- =====================================================
-- TABLA SESSIONS
-- =====================================================

CREATE TABLE sessions (

    -- ID de la sesión
    IDsession INT AUTO_INCREMENT PRIMARY KEY,

    -- Mascota que juega esa sesión
    IDpet INT NOT NULL,

    -- Fecha y hora de inicio
    inicio DATETIME NOT NULL,

    -- Fecha y hora de finalización
    fin DATETIME,

    -- Duración en minutos
    duracion INT,

    -- Relación con pets
    FOREIGN KEY (IDpet)
    REFERENCES pets(IDpet)

);


-- =====================================================
-- TABLA PETSTATELOGS
-- =====================================================

CREATE TABLE petstatelogs (

    -- Registro de estado
    IDlog INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión correspondiente
    IDsession INT NOT NULL,

    -- Momento del registro
    timestamp DATETIME NOT NULL,

    -- Valores entre 0 y 100
    hambre INT CHECK(hambre BETWEEN 0 AND 100),

    diversion INT CHECK(diversion BETWEEN 0 AND 100),

    higiene INT CHECK(higiene BETWEEN 0 AND 100),

    energia INT CHECK(energia BETWEEN 0 AND 100),

    salud INT CHECK(salud BETWEEN 0 AND 100),

    -- Relación con sessions
    FOREIGN KEY (IDsession)
    REFERENCES sessions(IDsession)

);


-- =====================================================
-- TABLA ACTIONTYPES
-- =====================================================

CREATE TABLE actiontypes (

    -- ID de la acción
    IDaction INT AUTO_INCREMENT PRIMARY KEY,

    -- Nombre de la acción
    nombre VARCHAR(50) NOT NULL,

    -- Efectos que produce
    efecto_hambre INT,
    efecto_diversion INT,
    efecto_higiene INT,
    efecto_energia INT,
    efecto_salud INT

);


-- =====================================================
-- TABLA ACTIONLOGS
-- =====================================================

CREATE TABLE actionlogs (

    -- Registro de acciones realizadas
    IDlog INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión donde ocurrió
    IDsession INT NOT NULL,

    -- Acción realizada
    IDaction INT NOT NULL,

    -- Fecha y hora
    timestamp DATETIME NOT NULL,

    -- Relaciones
    FOREIGN KEY (IDsession)
    REFERENCES sessions(IDsession),

    FOREIGN KEY (IDaction)
    REFERENCES actiontypes(IDaction)

);


-- =====================================================
-- TABLA EVENTS
-- =====================================================

CREATE TABLE events (

    -- Evento aleatorio
    IDevent INT AUTO_INCREMENT PRIMARY KEY,

    -- Nombre del evento
    nombre VARCHAR(50) NOT NULL,

    -- Descripción del efecto
    efecto VARCHAR(100)

);


-- =====================================================
-- TABLA EVENTLOGS
-- =====================================================

CREATE TABLE eventlogs (

    -- Registro de eventos
    IDlog INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión
    IDsession INT NOT NULL,

    -- Evento ocurrido
    IDevent INT NOT NULL,

    -- Momento del evento
    timestamp DATETIME NOT NULL,

    FOREIGN KEY (IDsession)
    REFERENCES sessions(IDsession),

    FOREIGN KEY (IDevent)
    REFERENCES events(IDevent)

);


-- =====================================================
-- TABLA SESSIONRESULTS
-- =====================================================

CREATE TABLE sessionresults (

    -- Resultado de la sesión
    IDresult INT AUTO_INCREMENT PRIMARY KEY,

    -- Sesión evaluada
    IDsession INT NOT NULL,

    -- Promedio de felicidad
    felicidad_promedio INT,

    -- Duración total
    duracion_total INT,

    -- Estado final
    estado_final VARCHAR(30),

    FOREIGN KEY (IDsession)
    REFERENCES sessions(IDsession)

);


